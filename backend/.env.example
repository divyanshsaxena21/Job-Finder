# Database
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=job_finder

# JWT (Security - Change in production!)
JWT_SECRET_KEY=your_super_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Groq AI (Get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Telegram (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Server URLs - Update for Render + Vercel deployment
BACKEND_URL=https://your-backend.onrender.com
FRONTEND_URL=https://job-finder-pearl.vercel.app

# CORS Origins - Allow your Vercel frontend
CORS_ORIGINS=https://job-finder-pearl.vercel.app,https://*.vercel.app

# Environment
ENVIRONMENT=production

# Application Limits
DAILY_APPLICATION_LIMIT=5


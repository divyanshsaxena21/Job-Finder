# Main project .gitignore

# ===== ENVIRONMENT VARIABLES =====
.env
.env.local
.env.*.local
.env.production

# ===== FRONTEND (Node.js / npm) =====
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.env
frontend/.env.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnp
frontend/.pnp.js

# ===== BACKEND (Python) =====
# Virtual Environments
backend/venv/
backend/env/
backend/.venv/
backend/ENV/
backend/venv.bak/
backend/env.bak/

# Python cache
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/.Python
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
backend/pip-wheel-metadata/
backend/share/python-wheels/
backend/*.egg-info/
backend/.installed.cfg
backend/*.egg
backend/MANIFEST

# Python testing & coverage
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/.tox/
backend/.hypothesis/

# Python linting & type checking
backend/.mypy_cache/
backend/.dmypy.json
backend/dmypy.json
backend/.pyre/

# Python logs
backend/uvicorn.log
backend/*.log

# ===== IDE & EDITORS =====
.vscode/
.vscode/settings.json
.vscode/extensions.json
.idea/
.idea/workspace.xml
.idea/misc.xml
.idea/modules.xml
*.sublime-workspace
*.sublime-project
.atom/
.project
.pydevproject
.settings/
*.swp
*.swo
*~

# ===== OS FILES =====
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ===== BUILD & DIST =====
dist/
build/
.next/
out/
*.tgz

# ===== TEMPORARY FILES =====
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

# ===== LOGS =====
*.log
logs/
*.log.gz

# ===== CACHE =====
.cache/
.turbo/
.eslintcache
.node_modules/

# ===== DATABASE =====
*.db
*.sqlite
*.sqlite3
mongodata/

# ===== TESTING =====
.coverage
htmlcov/
.pytest_cache/
coverage/

# ===== PACKAGE MANAGERS =====
package-lock.json
yarn.lock
poetry.lock
pnpm-lock.yaml

# ===== MISC =====
.env.test
.env.development.local
.env.test.local
.env.production.local
.turbopack/

# Do NOT ignore example files
!.env.example
!.env.local.example
!.env.production.example
!.gitkeep

# Local Development Environment Configuration
# Copy this file to .env.local and fill in with your local values

# ============================================
# BACKEND LOCAL DEVELOPMENT (.env.local)
# ============================================

# Database - Local MongoDB
MONGODB_URL=mongodb://localhost:27017
DB_NAME=job_finder

# JWT - Use any string for development
JWT_SECRET_KEY=dev_super_secret_key_keep_it_simple_for_testing
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Groq AI - Get free API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_from_console_here

# Telegram - Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Local URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development

# Application Limits
DAILY_APPLICATION_LIMIT=50

# ============================================
# FRONTEND LOCAL DEVELOPMENT (.env.local)
# ============================================

# API Configuration - Points to local backend
VITE_API_URL=http://localhost:8000
VITE_DEBUG=true

# ============================================
# LOCAL SETUP CHECKLIST
# ============================================

# 1. Database Setup
#    [ ] Install MongoDB locally or use MongoDB Atlas
#    [ ] If local: `mongod` is running on port 27017
#    [ ] If Atlas: Copy connection string to MONGODB_URL

# 2. Create Files
#    [ ] backend/.env.local (for backend development)
#    [ ] frontend/.env.local (for frontend development)

# 3. Install Dependencies
#    [ ] cd backend && pip install -r requirements.txt
#    [ ] cd frontend && npm install

# 4. Start Services
#    [ ] Backend: cd backend && python -m app.main
#    [ ] Frontend: cd frontend && npm run dev

# 5. Verify Everything
#    [ ] Backend API: http://localhost:8000/docs
#    [ ] Frontend: http://localhost:5173
#    [ ] Try registering a test user

# ============================================
# QUICK START WITH LOCAL SETUP
# ============================================

# Step 1: Install MongoDB
# Windows: Download from https://www.mongodb.com/try/download/community
# Mac: brew install mongodb-community
# Linux: Follow https://docs.mongodb.com/manual/installation/

# Step 2: Start MongoDB (if local)
# Windows: mongod --dbpath C:\data\db
# Mac: brew services start mongodb-community
# Linux: sudo systemctl start mongod

# Step 3: Copy Configuration
# cp backend/.env.example backend/.env.local
# cp frontend/.env.example frontend/.env.local

# Step 4: Get API Keys
# 1. Groq: https://console.groq.com → Create API key
# 2. Telegram: Message @BotFather → /newbot → Copy token

# Step 5: Update .env Files
# Edit backend/.env.local and add:
#   - GROQ_API_KEY from step 4.1
#   - TELEGRAM_BOT_TOKEN from step 4.2

# Step 6: Install and Run
# cd backend && pip install -r requirements.txt
# cd .. && cd frontend && npm install
# Open 2 terminals:
#   Terminal 1: cd backend && python -m app.main
#   Terminal 2: cd frontend && npm run dev

# Step 7: Test
# Open http://localhost:5173
# Register a test account
# Add a test job
# Try the features!

